import Hadwiger.Orbit

/-!
# The main theorem: `H₃ ≤ 13`

The only non-standard assumptions are
* the axiom `all_leaves_pass` (the certificate: every one of the 39,950 certified start boxes, i.e.
  the 39,380 old ones and the 570 extension boxes, is tiled by bisection-tree leaves passing the
  strict leaf check `LeafOK`; established by `code/newmethod/certcheck_strict.py` on all 7,561,583 leaves,
  and independently, with a structure-free predicate, by `code/replay/hcheck.py --strict`), and
* `gridCheck_true._native.native_decide.ax_1_1`, generated by `native_decide` in `gridCheck_true` (finite orbit coverage of the
  `1/10`-grid; also checked by `code/replay/orbitboxes.py` and `code/newmethod/certcheck_ext.py`).
-/

namespace Hadwiger

/-- **The certificate.**  Every certified start box (old `U^D_20` start boxes and the 570
extension boxes) is tiled by a bisection tree all of whose leaves pass the strict leaf check. -/
axiom all_leaves_pass : ∀ k : Fin 6 → ℕ, CertIdx k → Certified (startBox k)

/-- **Main theorem (`H₃ ≤ 13`).**  Every convex body in `ℝ³` is covered by 13 translates of its
interior. -/
theorem H3_le_13 (K : Set E3) (hK : IsConvexBody K) : CoveredByInteriorTranslates 13 K := by
  refine H3_le_13_of_symcover {B | ∃ k, CertIdx k ∧ B = startBox k} ?_ (fun c hc => ?_) K hK
  · rintro B ⟨k, hk, rfl⟩; exact all_leaves_pass k hk
  · obtain ⟨g1, g2, k, hk, hm⟩ := orbit_cover c hc
    exact ⟨g2.comp g1, startBox k, ⟨k, hk, rfl⟩, by rw [gcfg_comp]; exact hm⟩

/-- **Main theorem, homothet form.**  Every convex body in `ℝ³` is covered by 13 smaller
homothetic copies `x_i + r K`, `0 < r < 1`. -/
theorem H3_le_13_homothets (K : Set E3) (hK : IsConvexBody K) :
    ∃ r : ℝ, 0 < r ∧ r < 1 ∧ ∃ x : Fin 13 → E3, K ⊆ ⋃ i, (fun y => x i + r • y) '' K :=
  homothets_of_interior hK (H3_le_13 K hK)

end Hadwiger
